[Unit]
Description=NXMS wallet-rpc STUB (etap C, monero-a boundary placeholder)
After=network.target

[Service]
Type=simple
User=monero-a
Group=monero-a
ExecStart=/usr/bin/python3 /opt/nxms/bin/wallet-rpc-stub.py 38088
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/nxms-monero-a/service.log
StandardError=append:/var/log/nxms-monero-a/service.log
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/log/nxms-monero-a
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
